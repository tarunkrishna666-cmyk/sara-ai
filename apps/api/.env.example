SUPER_ADMIN_EMAIL=tarunkrishn666@gmail.com
SUPER_ADMIN_PASSWORD=StrongSecurePassword
ADMIN_API_KEY=RandomSecureApiKeyWithAtLeast32Characters
SESSION_TTL_DAYS=14

GROQ_API_KEY=
